# ══════════════════════════════════════════════════════════════
# Hey Frank-O — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env.local for local development.
# Add ALL of these to Vercel → Project → Settings → Environment Variables.
# NEVER commit .env.local to the repository.
# ══════════════════════════════════════════════════════════════

# ── General ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://heyfranko.com
CONTACT_EMAIL=contact@HeyFranko.com          # server-side only (no NEXT_PUBLIC_)

# ── Resend (email sending) ─────────────────────────────────────
# Get at: https://resend.com → API Keys
# Free tier: 100 emails/day, 3,000/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Supabase ───────────────────────────────────────────────────
# Get at: https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx...     # safe to expose — RLS enforces access
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx...         # SECRET — never NEXT_PUBLIC_, server-side only

# ── NextAuth (Auth.js v5) ──────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-random-secret-here
NEXTAUTH_URL=https://heyfranko.com           # omit on Vercel (auto-detected)

# ── Google OAuth ───────────────────────────────────────────────
# Get at: console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: https://heyfranko.com/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── Facebook OAuth ─────────────────────────────────────────────
# Get at: developers.facebook.com → Your App → Settings → Basic
# Valid OAuth redirect URI: https://heyfranko.com/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=xxxx
FACEBOOK_CLIENT_SECRET=xxxx

# ── Upstash Redis (rate limiting — production only) ────────────
# Get at: https://console.upstash.com → Create Database → REST API
# Free tier: 10,000 requests/day
# npm install @upstash/ratelimit @upstash/redis
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# ── Bookable integration (add when API keys are provided) ──────
# NEXT_PUBLIC_BOOKABLE_URL=https://bookable.io/hey-franko
# BOOKABLE_API_KEY=xxxx
