# ── Hey Frank-O Environment Variables ──
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to the repository.

# Contact email (used in form handlers and legal docs)
NEXT_PUBLIC_CONTACT_EMAIL=contact@HeyFranko.com

# Email service (e.g. Resend, SendGrid) — add when wiring real form submissions
# RESEND_API_KEY=

# Booking platform (Bookable) — add if they expose a client key
# NEXT_PUBLIC_BOOKABLE_KEY=

# Authentication (add when implementing next-auth)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://heyfranko.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
