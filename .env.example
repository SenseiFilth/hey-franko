# ══════════════════════════════════════════════════════════════
# Hey Frank-O — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy to .env.local for local dev.
# Add to: Vercel → Project → Settings → Environment Variables
# Never commit .env.local to the repository.
# ══════════════════════════════════════════════════════════════

# ── Contact email (server-side only — no NEXT_PUBLIC_ prefix) ─
CONTACT_EMAIL=contact@HeyFranko.com

# ── Resend — email delivery ────────────────────────────────────
# Sign up: https://resend.com (free: 100 emails/day)
# When set, all form submissions send real emails.
# When absent, submissions are logged to console (dev mode).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Supabase — database + auth (add when ready) ───────────────
# Sign up: https://supabase.com
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx...   # SECRET — never NEXT_PUBLIC_

# ── Google OAuth (add when wiring Supabase Auth) ──────────────
# console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client
# Redirect URI: https://xxxx.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ── Facebook OAuth (add when wiring Supabase Auth) ────────────
# developers.facebook.com → Your App → Settings → Basic
# Redirect URI: https://xxxx.supabase.co/auth/v1/callback
FACEBOOK_CLIENT_ID=xxxx
FACEBOOK_CLIENT_SECRET=xxxx
